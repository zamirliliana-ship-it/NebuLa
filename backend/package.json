{
  "name": "nebula-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "check:local": "node scripts/check-local.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}