NODE_ENV=development
PORT=3000
# Orígenes permitidos del frontend, separados por coma (sin "/" final)
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# SOLO backend. Nunca en el frontend ni en Git.
SUPABASE_SERVICE_ROLE_KEY=

# URL de la implementación web de Apps Script (termina en /exec)
APPS_SCRIPT_URL=
# Mismo valor que SHARED_SECRET en las propiedades del script. Mínimo 32 caracteres.
APPS_SCRIPT_SECRET=
# Pimienta para el hash de los códigos OTP. Mínimo 32 caracteres, distinta de la anterior.
OTP_PEPPER=
