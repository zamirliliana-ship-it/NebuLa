NODE_ENV=development
PORT=3000

FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Esta clave se utiliza únicamente en el backend.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección de Apps Script, terminada en /exec.
APPS_SCRIPT_URL=

# Debe coincidir con SHARED_SECRET de Apps Script.
# Mínimo 32 caracteres.
APPS_SCRIPT_SECRET=

# Mínimo 32 caracteres y diferente de APPS_SCRIPT_SECRET.
OTP_PEPPER=

# Comprueba si una contraseña nueva aparece en filtraciones conocidas.
PASSWORD_BREACH_CHECK=true